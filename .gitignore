# Ignore common system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Node modules (if any future JS tooling is added)
node_modules/

# Python environment (if added later)
.venv/
__pycache__/
*.pyc

# Bluetooth captures — these record ALL HCI traffic from the phone, not just
# the treadmill (watch, headphones, car), so they never belong in a public repo.
captures/
*.pklg
*.pcap
*.pcapng
*.btsnoop

# Wahoo OAuth token cache — never commit
.wahoo_token.json
